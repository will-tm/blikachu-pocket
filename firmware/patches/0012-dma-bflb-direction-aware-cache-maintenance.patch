diff --git a/drivers/dma/dma_bflb.c b/drivers/dma/dma_bflb.c
index 4fe08ea016d..7e247530bbb 100644
--- a/drivers/dma/dma_bflb.c
+++ b/drivers/dma/dma_bflb.c
@@ -56,6 +56,7 @@ LOG_MODULE_REGISTER(dma_bflb, CONFIG_DMA_LOG_LEVEL);
 #define BFLB_DMA_FLOW_PERI 4
 
 struct dma_bflb_channel {
+	enum dma_channel_direction direction;
 	dma_callback_t cb;
 	void *user_data;
 };
@@ -268,6 +269,7 @@ static int dma_bflb_configure(const struct device *dev, uint32_t channel,
 			+ DMA_CxCONFIG_OFFSET + BFLB_DMA_CH_OFFSET(channel));
 
 	channel_control = &data->channels[channel];
+	channel_control->direction = config->channel_direction;
 	channel_control->cb = config->dma_callback;
 	channel_control->user_data = config->user_data;
 
@@ -280,9 +282,27 @@ static int dma_bflb_configure(const struct device *dev, uint32_t channel,
 	return 0;
 }
 
+/* The BL61x wireless-memory region is mapped through a non-cached
+ * SRAM alias. Cache maintenance there is unnecessary, unlike cached OCRAM.
+ */
+static bool dma_bflb_uncached_buffer(uintptr_t address, size_t length)
+{
+#if defined(CONFIG_SOC_SERIES_BL61X) && DT_NODE_EXISTS(DT_NODELABEL(wifi_ram))
+	uintptr_t base = DT_REG_ADDR(DT_NODELABEL(wifi_ram));
+	uintptr_t end = base + DT_REG_SIZE(DT_NODELABEL(wifi_ram));
+
+	return address >= base && address < end && length <= end - address;
+#else
+	ARG_UNUSED(address);
+	ARG_UNUSED(length);
+	return false;
+#endif
+}
+
 static int dma_bflb_start(const struct device *dev, uint32_t channel)
 {
 	const struct dma_bflb_config *cfg = dev->config;
+	struct dma_bflb_data *data = dev->data;
 	uint32_t config;
 
 #if defined(CONFIG_SOC_SERIES_BL61X) || defined(CONFIG_SOC_SERIES_BL808) \
@@ -296,14 +316,27 @@ static int dma_bflb_start(const struct device *dev, uint32_t channel)
 
 	pending_length *= dma_bflb_get_transfer_size(dev, channel);
 
-	sys_cache_data_flush_and_invd_range((void *)addr, pending_length);
+	/* Peripheral FIFOs are MMIO, not memory buffers. TX sources are
+	 * read-only to DMA: clean them, but keep their CPU cache lines.
+	 */
+	if (data->channels[channel].direction != MEMORY_TO_PERIPHERAL &&
+	    !dma_bflb_uncached_buffer(addr, pending_length)) {
+		sys_cache_data_flush_and_invd_range((void *)addr, pending_length);
+	}
 
 	addr = sys_read32(
 		cfg->base_reg + DMA_CxSRCADDR_OFFSET + BFLB_DMA_CH_OFFSET(channel));
 
-	sys_cache_data_flush_and_invd_range((void *)addr, pending_length);
+	if (data->channels[channel].direction != PERIPHERAL_TO_MEMORY &&
+	    !dma_bflb_uncached_buffer(addr, pending_length)) {
+		sys_cache_data_flush_range((void *)addr, pending_length);
+	}
 #endif
 
+	/* Publish CPU writes before enabling peripheral DMA, including
+	 * buffers that intentionally bypass the data cache.
+	 */
+	__asm__ volatile("fence iorw, iorw" ::: "memory");
 	config = sys_read32(cfg->base_reg + DMA_CxCONFIG_OFFSET + BFLB_DMA_CH_OFFSET(channel));
 	config |= DMA_E;
 	sys_write32(config, cfg->base_reg + DMA_CxCONFIG_OFFSET + BFLB_DMA_CH_OFFSET(channel));
