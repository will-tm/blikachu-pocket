+	uintptr_t address = (uintptr_t)buf;
+	uintptr_t base = DT_REG_ADDR(DT_NODELABEL(wifi_ram));
+	uintptr_t end = base + DT_REG_SIZE(DT_NODELABEL(wifi_ram));
+
+	direct = address >= base && address < end && len <= end - address;
+#endif
+	bool word_mode = (len % 4) == 0 && (!direct || ((uintptr_t)buf % 4) == 0);
+	size_t width = word_mode ? 4 : 1;
+	unsigned burst = 4;
+	unsigned threshold = SPI_FIFO_SIZE / 2;
+#if defined(CONFIG_SOC_SERIES_BL61X)
+	bool probe = spi_dma_probe.active && direct && word_mode;
+	if (probe) {
+		burst = spi_dma_probe.burst;
+		threshold = burst * width;
+	}
+#endif
+	size_t max_chunk = ROUND_DOWN(SPI_BFLB_DMA_MAX_XFER * width, 32);
