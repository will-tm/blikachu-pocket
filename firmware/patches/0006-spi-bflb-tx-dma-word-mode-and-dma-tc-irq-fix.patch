+static __ramfunc int spi_bflb_tx_dma(const struct device *dev, const uint8_t *buf, size_t len)
+{
+	const struct spi_bflb_cfg *cfg = dev->config;
+	struct spi_bflb_data *data = dev->data;
+	struct dma_block_config block = {0};
+	struct dma_config dcfg = {0};
+	const size_t stride = SPI_BFLB_DMA_BUFFER_SIZE / 2;
