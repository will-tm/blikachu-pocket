+	unsigned int current = 0;
+	uint32_t saved = sys_read32(cfg->base + SPI_CONFIG_OFFSET);
+	uint32_t tmp;
+	int rc;
+
+	if (!direct) {
+		memcpy(data->dma_buf, buf, chunk);
+	}
+	k_sem_reset(&data->dma_done);
+	data->dma_status = 0;
