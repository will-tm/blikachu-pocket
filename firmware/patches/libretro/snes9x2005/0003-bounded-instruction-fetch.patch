+#include "../copyright"
+#ifndef _CPUFETCH_H_
+#define _CPUFETCH_H_
+
+/* Program fetches wrap within PB and follow each 4 KiB mapping. A borrowed
+ * cartridge has no writable padding beyond its mapped extent. */
+static INLINE uint8_t S9xPCRead(unsigned offset)
+{
+#if defined(SNES_READONLY_ROM) && !defined(SA1_OPCODES)
+   uint32_t address = ICPU.ShiftedPB |
+      (uint16_t)((uintptr_t)CPU.PC - (uintptr_t)CPU.PCBase + offset);
+   uint8_t *map = Memory.Map[address >> MEMMAP_SHIFT];
+   if ((uintptr_t)map >= MAP_LAST)
+      return map[address & 0xffff];
+   int32_t cycles = CPU.Cycles;
+   uint8_t value = S9xGetByte(address);
+   CPU.Cycles = cycles;
+   return value;
+#else
+   return CPU.PC[offset];
+#endif
+}
+
+static INLINE uint8_t S9xPCReadNext(void)
+{
+   uint8_t value = S9xPCRead(0);
+   CPU.PC++;
+   return value;
+}
+
+static INLINE uint16_t S9xPCReadWord(unsigned offset)
+{
+   uint16_t low = S9xPCRead(offset);
+   return low | ((uint16_t)S9xPCRead(offset + 1) << 8);
+}
+
+static INLINE uint32_t S9xPCReadLong(void)
+{
+   uint32_t low = S9xPCReadWord(0);
+   return low | ((uint32_t)S9xPCRead(2) << 16);
+}
+
+static INLINE void S9xPCPrepare(void)
+{
+#if defined(SNES_READONLY_ROM) && !defined(SA1_OPCODES)
+   uintptr_t pc = (uintptr_t)CPU.PC - (uintptr_t)CPU.PCBase;
+   uint32_t address = ICPU.ShiftedPB | (uint16_t)pc;
+   if (pc > 0xffff || CPU.PCBase != Memory.Map[address >> MEMMAP_SHIFT])
+      S9xSetPCBase(address);
+#endif
+}
+
+static INLINE uint16_t S9xPCImmediateWord(uint32_t address)
+{
+#if defined(SNES_READONLY_ROM) && !defined(SA1_OPCODES)
+   if ((address & 0xffff) == 0xffff)
+   {
+      OpenBus = S9xGetByte(address);
+      return OpenBus | ((uint16_t)S9xGetByte(address & 0xff0000) << 8);
+   }
+#endif
+   return S9xGetWord(address);
+}
+#endif
